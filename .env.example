# Identity
ASSISTANT_NAME=Furby Open
ASSISTANT_OWNER_NAME=User
ASSISTANT_TIMEZONE=UTC
# Optional default used by the weather tool, for example: London, UK
ASSISTANT_LOCATION=
MOBILE_WORKSPACE_ROOT=furby-open-workspace

# Telegram
# Create a new bot with @BotFather. Never reuse credentials from another deployment.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID that is allowed to use this bot.
TELEGRAM_USER_ID=

# Models
# Furby Open falls back to the first model available through Pi if these are unavailable.
DEFAULT_MODEL=openai-codex/gpt-5.6-sol
FALLBACK_MODEL=minimax/MiniMax-M3

# Optional API-key overrides. Shared Pi OAuth/auth is preferred where available.
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Pi runtime
# Leave blank to use ~/.pi/agent.
PI_AUTH_PATH=
PI_AGENT_DIR=
PI_MODELS_PATH=
PI_THINKING_LEVEL=medium
PI_PROMPT_TIMEOUT_SECONDS=900
PI_SESSION_ROOT=.data/sessions
# Keep this false to load only the starter/project skills committed in this repo.
FURBY_OPEN_LOAD_GLOBAL_SKILLS=false

# Public default is safe. Coding mode grants the model read/bash/edit/write access.
FURBY_OPEN_TOOL_MODE=safe

# Rapid Telegram messages received in this window become one request.
TELEGRAM_COALESCE_MS=800

# Optional local A2A endpoint. Disabled by default because the protocol is unauthenticated.
FURBY_OPEN_A2A_ENABLED=false
FURBY_OPEN_A2A_HOSTNAME=127.0.0.1
FURBY_OPEN_A2A_PORT=3013
FURBY_OPEN_A2A_DIR=.data/a2a
FURBY_OPEN_A2A_MAX_CONCURRENCY=2

SHOW_THINKING_STREAM=false

# Voice transcription
TRANSCRIPTION_PROVIDER=local
WHISPER_CPP_BIN=.data/local/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=.data/local/whisper.cpp/models/ggml-tiny.en.bin
